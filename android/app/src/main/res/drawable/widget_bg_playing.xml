<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#E3171F2B"
                android:centerColor="#D9151D2A"
                android:endColor="#D20D131E" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#6B8FFFD0" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#07FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
